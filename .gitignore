# .gitignore padrão para Python

# Python: Cache e Artefatos
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg

# Distribuição e Instalação
*.egg-info/
.eggs/
dist/
build/

# Ambientes Virtuais
.venv/
venv/
env/

# IDEs
.vscode/
.idea/

# MkDocs: Documentação Compilada
site/

# Específico do seu projeto (Para o Simulador/GA)
results/
logs/
temp/
*.log
*.csv
!configs/*.csv  # Não ignorar CSVs dentro da pasta configs (se forem entradas pequenas)